{
  "name": "testmu-sdet1-vikas",
  "version": "1.0.0",
  "private": true,
  "description": "AI-native regression framework for the TestMu AI SDET-1 assessment — Playwright + TypeScript with an agentic LLM failure explainer, self-healing locator proposals and a cross-run flaky classifier.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=mobile-chrome",
    "test:login": "playwright test tests/login",
    "test:dashboard": "playwright test tests/dashboard",
    "demo": "tsx scripts/run-demo.ts",
    "demo:capture": "tsx scripts/run-demo.ts --capture",
    "generate:cases": "tsx scripts/generate-test-cases.ts",
    "check:trace": "tsx scripts/check-traceability.ts",
    "verify:target": "tsx scripts/verify-target.ts",
    "verify:llm": "tsx scripts/verify-llm.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "ai",
    "sdet",
    "llm",
    "agentic",
    "test-automation"
  ],
  "author": "Vikas Kumar Saini",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "dotenv": "^16.4.7",
    "zod": "^4.6.7"
  }
}
