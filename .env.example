# ---------------------------------------------------------------------------
# Copy to `.env` (gitignored), paste your key, done.  Check it: npm run verify:llm
# ---------------------------------------------------------------------------

# --- LLM model -------------------------------------------------------------
# One model does both AI jobs in this repo, called over its API:
#   Task 2 — generates test cases from prompts/   (npm run generate:cases)
#   Task 3 — explains and classifies failing tests (every npm test / npm run demo)
# Groq free tier, no card: https://console.groq.com/keys
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# --- Other providers (optional) ----------------------------------------------
# Switch by setting AI_PROVIDER + that provider's key. AI_MODEL defaults per
# provider (src/ai/llm/providers.ts) — delete the AI_MODEL line above when switching.
# Google Gemini, free tier:   AI_PROVIDER=gemini      GEMINI_API_KEY=      https://aistudio.google.com/apikey
# Cerebras, free tier:        AI_PROVIDER=cerebras    CEREBRAS_API_KEY=    https://cloud.cerebras.ai
# OpenRouter:                 AI_PROVIDER=openrouter  OPENROUTER_API_KEY=  https://openrouter.ai/keys
# Anthropic (paid API):       AI_PROVIDER=anthropic   ANTHROPIC_API_KEY=   https://console.anthropic.com
# Local (Ollama, LM Studio):  AI_PROVIDER=custom      AI_BASE_URL=http://localhost:11434/v1

# --- AI layer behaviour (defaults shown) ------------------------------------
# AI_EXPLAIN=1                  # 0 = run the suite with zero LLM calls
# AI_MAX_CALLS_PER_RUN=10       # failures triaged per run, shared across workers
# AI_MAX_AGENT_STEPS=5          # tool round-trips per failure
# AI_REASONING_EFFORT=low       # sent to models that support it; "off" to omit
# AI_DISABLE_TOOLS=1            # single-prompt fallback if verify:llm says the model won't call tools

# --- System under test (defaults shown) -------------------------------------
# BASE_URL=https://practice.expandtesting.com/notes/app
# API_BASE_URL=https://practice.expandtesting.com/notes/api
# No test account needed: tests register, seed and delete their own users.
