# ---------------------------------------------------------------------------
# Copy to `.env` (gitignored) and set ONE LLM key. That is the only required step.
# Check it with:  npm run verify:llm
# ---------------------------------------------------------------------------

# --- LLM provider: set one key; the first one found is used ----------------
# Groq — free tier, no card. Used for every sample in this repo.   https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini — free tier, no card.                               https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras — free tier.                                             https://cloud.cerebras.ai
# CEREBRAS_API_KEY=
# OpenRouter — some ":free" models.                                 https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Anthropic — paid API (a claude.ai subscription does NOT include it). https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional overrides
# AI_PROVIDER=groq              # gemini | groq | cerebras | openrouter | anthropic | custom
# AI_MODEL=openai/gpt-oss-120b  # defaults: see src/ai/llm/providers.ts
# AI_REASONING_EFFORT=low       # sent to providers that support it; "off" to omit
# AI_BASE_URL=http://localhost:11434/v1   # AI_PROVIDER=custom (Ollama, LM Studio, vLLM…)
# AI_API_KEY=                   # only if your custom endpoint needs one

# --- AI layer behaviour ---------------------------------------------------
# AI_EXPLAIN=0                  # run the suite with zero LLM calls
# AI_MAX_CALLS_PER_RUN=10       # failures triaged per run, shared across workers
# AI_MAX_AGENT_STEPS=5          # tool round-trips per failure
# AI_DISABLE_TOOLS=1            # single-prompt fallback if verify:llm says the model won't call tools

# --- System under test (defaults shown) -------------------------------------
# BASE_URL=https://practice.expandtesting.com/notes/app
# API_BASE_URL=https://practice.expandtesting.com/notes/api
# No test account needed: tests register, seed and delete their own users.
